{
  "name": "@dogic/plugin-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/shared/index.js",
  "types": "./dist/shared/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./main": {
      "types": "./dist/main/index.d.ts",
      "import": "./dist/main/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "innate": {
    "plugin": {
      "id": "workspace",
      "host": "dist/main/index.js",
      "client": "dist/plugin.js",
      "provides": ["workspace-fs", "workspace-git"],
      "consumes": []
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dogic/core": "workspace:*",
    "@dogic/kernel": "workspace:*",
    "@dogic/syntax-highlighting": "workspace:*",
    "react": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.4"
  }
}
