{
  "name": "@dogic/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "innate-dogic 桌面宿主（Electron）——复刻 dsh-desktop 形态：宿主拉起 dsh Harness Web UI，叠加 magpie 模型网关集成层",
  "author": "Innate",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "package": "electron-vite build && tsx scripts/package.ts",
    "package:dir": "electron-vite build && tsx scripts/package.ts --dir"
  },
  "dependencies": {
    "@dogic/core": "workspace:*",
    "@dogic/kernel": "workspace:*",
    "@dogic/plugin-workspace": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "43.7.11",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "vite": "^7.0.0"
  }
}
