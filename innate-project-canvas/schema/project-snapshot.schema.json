{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innate-labs.local/schemas/project-snapshot-1.0.0.json",
  "title": "Innate project snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "generatedAt", "sources", "sprints", "tasks", "modules", "moduleEdges"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "project": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "sprints": { "type": "array", "items": { "$ref": "#/$defs/sprint" } },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "moduleEdges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "status"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["file", "directory"] },
        "status": { "enum": ["verified", "missing", "unverified"] }
      }
    },
    "sprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "estimate", "declaredStatus", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "estimate": { "type": "string" },
        "declaredStatus": { "type": "string" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sprintId", "title", "status", "summary", "purpose", "verification", "estimate", "blockedBy", "evidence", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^T(?:[0-9]+|[A-Z]+)\\.[0-9]+$" },
        "sprintId": { "type": "string", "pattern": "^S[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["done", "partial", "todo", "optional", "debt"] },
        "summary": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string" },
        "verification": { "type": "string", "minLength": 1 },
        "estimate": { "type": "string" },
        "blockedBy": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "packageName", "path", "layer", "presence", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "packageName": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "layer": { "enum": ["app", "plugin", "package", "service", "site", "tool", "external"] },
        "presence": { "enum": ["current", "target"] },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "label", "view"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "view": { "enum": ["current", "target", "both"] }
      }
    }
  }
}
