{
  "name": "innate-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "innate-desktop 产品 monorepo：共享底座 + 轻应用平台。UI 基座来自 innate-fe（@innate/ui），以私有 npm registry 源码包方式消费，不做源码并入。",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && pnpm exec tsc -p tools/tsconfig.json --noEmit && pnpm check:typescript",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "verify": "pnpm typecheck && pnpm test",
    "ui:sync": "node tools/ui-sync.mjs",
    "ui:sync:bump": "node tools/ui-sync.mjs --bump patch",
    "ui:sync:dry-run": "node tools/ui-sync.mjs --dry-run",
    "check:typescript": "tsx tools/check-typescript.ts",
    "dev": "pnpm --filter @dogic/desktop run dev",
    "dev:shell": "pnpm --filter @dogic/shell run build && pnpm --filter @dogic/shell run start",
    "start": "tsx tools/start-all.ts",
    "smoke:desktop": "tsx tools/smoke-desktop.ts",
    "smoke:magpie": "tsx tools/smoke-magpie.ts",
    "verify:overlay": "tsx tools/verify-overlay.ts",
    "package": "pnpm --filter @dogic/desktop run package",
    "package:dir": "pnpm --filter @dogic/desktop run package:dir",
    "package:portable": "tsx tools/package-portable.ts"
  },
  "dependencies": {
    "@innate/ui": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5",
    "typescript": "^7.0.2"
  }
}
